<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto" xmlns:android="http://schemas.android.com/apk/res/android">

    <PreferenceCategory
        app:layout="@layout/preference_category_material_card">

        <SwitchPreferenceCompat
            android:key="persistentVpnNotification"
            android:title="@string/persistent_vpn_notification_title"
            android:summary="@string/persistent_vpn_notification_summary"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="overrideDns"
            android:summary="When enabled, the client uses custom DNS servers to resolve internal resources and aliases. This overrides your system's default DNS settings. Queries that cannot be resolved as a Pangolin resource will be forwarded to your configured Upstream DNS Server."
            android:title="Enable Aliases (DNS Override)"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="tunnelDns"
            android:summary="When enabled, DNS queries are routed through the tunnel for remote resolution. To ensure queries are tunneled correctly, you must define the DNS server as a Pangolin resource and enter its address as an Upstream DNS Server."
            android:title="DNS Over Tunnel"
            app:iconSpaceReserved="false" />
        <EditTextPreference
            android:key="primaryDNSServer"
            android:title="Primary Upstream DNS Server"
            app:iconSpaceReserved="false" />
        <EditTextPreference
            android:key="secondaryDNSServer"
            android:title="Secondary Upstream DNS Server"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="logCollectionEnabled"
            android:summary="When enabled, tunnel logs are saved to a file that can be downloaded for troubleshooting."
            android:title="Enable Log Collection"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />
        <EditTextPreference
            android:defaultValue="1280"
            android:key="mtu"
            android:title="MTU"
            android:summary="Maximum Transmission Unit size in bytes (576–65535). Default: 1280"
            app:useSimpleSummaryProvider="true"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="exitNodeTakesPrecedence"
            android:summary="When enabled, routes for individual resources are not added to the system and their aliases are not resolved, so all traffic is sent through the exit node instead of directly to resources."
            android:title="Exit Node Takes Precedence Over Resources"
            android:defaultValue="false"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="excludedAppsEntry"
            android:title="@string/excluded_apps_title"
            android:persistent="false"
            app:iconSpaceReserved="false" />

    </PreferenceCategory>

    <PreferenceCategory
        android:key="reliabilityCategory"
        app:layout="@layout/preference_category_material_card">
        <!-- The card layout has no title view: a non-selectable row acts as the heading. -->
        <Preference
            android:key="reliabilityHeader"
            android:title="@string/reliability_title"
            android:persistent="false"
            android:selectable="false"
            app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat
            android:key="autoReconnect"
            android:title="@string/auto_reconnect_title"
            android:summary="@string/auto_reconnect_summary"
            android:defaultValue="true"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="batteryOptimizationEntry"
            android:title="@string/battery_optimization_title"
            android:persistent="false"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="miuiAutostartEntry"
            android:title="@string/miui_autostart_title"
            android:summary="@string/miui_autostart_summary"
            android:persistent="false"
            app:isPreferenceVisible="false"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="miuiBatterySaverEntry"
            android:title="@string/miui_battery_saver_title"
            android:summary="@string/miui_battery_saver_summary"
            android:persistent="false"
            app:isPreferenceVisible="false"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="miuiRecentsLockEntry"
            android:title="@string/miui_recents_lock_title"
            android:summary="@string/miui_recents_lock_summary"
            android:persistent="false"
            android:selectable="false"
            app:isPreferenceVisible="false"
            app:iconSpaceReserved="false" />
        <Preference
            android:key="vpnAlwaysOnEntry"
            android:title="@string/vpn_always_on_title"
            android:summary="@string/vpn_always_on_summary"
            android:persistent="false"
            app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory
        app:layout="@layout/preference_category_material_card">
        <Preference
            android:title="See docs for more info on these settings"
            android:summary=""
            android:layout="@layout/preference_link"
            app:iconSpaceReserved="false">
            <intent
                android:action="android.intent.action.VIEW"
                android:data="https://docs.pangolin.net/manage/clients/configure-client" />
        </Preference>
    </PreferenceCategory>

</PreferenceScreen>
